# Copy to .streamlit/secrets.toml for local runs.
# On Streamlit Community Cloud, paste the same keys into
# App settings -> Secrets. Never commit the real values.

MONGO_URI = "mongodb+srv://<db_username>:<db_password>@bundelibhaiya.mghpona.mongodb.net/?retryWrites=true&w=majority&appName=bundeliBhaiya"

# Shared PIN the team enters to open the app. Remove this key to leave
# the app open to anyone with the URL.
APP_PIN = "<choose-a-pin>"
